# Copy to .env for the local agentic investigation stage. Deterministic
# detection does not need these settings.

# LM Studio's OpenAI-compatible local server.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Model ID reported by GET /v1/models.
LMSTUDIO_MODEL=qwen/qwen3.6-35b-a3b

# LM Studio does not require authentication by default. LangChain's OpenAI
# client requires a non-empty value, so this local placeholder is sufficient.
LMSTUDIO_API_KEY=lm-studio

# Shared fallback settings for callers that do not select a model role.
LMSTUDIO_TIMEOUT=180
LMSTUDIO_MAX_TOKENS=8192
LMSTUDIO_REASONING_EFFORT=none

# Investigation planning uses reasoning. This Qwen model exposes reasoning as
# effectively on/off; "medium" enables it through the OpenAI-compatible API.
LMSTUDIO_PLANNER_TIMEOUT=300
LMSTUDIO_PLANNER_MAX_TOKENS=16384
LMSTUDIO_PLANNER_REASONING_EFFORT=medium

# Report drafting is constrained by a JSON schema and does not need hidden
# reasoning, which preserves output tokens and predictable completion times.
LMSTUDIO_REPORTER_TIMEOUT=180
LMSTUDIO_REPORTER_MAX_TOKENS=8192
LMSTUDIO_REPORTER_REASONING_EFFORT=none

# Total wall-clock budget for baseline analysis and agent-selected tasks.
ONEMAIL_ANALYSIS_TIMEOUT=600

# Persistent local store for normalised indicators and similarity hashes. Raw
# messages and attachment bytes are never written to this database.
ONEMAIL_CORRELATION_DB=~/.onemail/correlation.sqlite3

# Optional VirusTotal API v3 enrichment. When configured, the planner may query
# existing file reports by SHA-256. OneMail never uploads files to VirusTotal.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_TIMEOUT=15
VIRUSTOTAL_CACHE_DB=~/.onemail/virustotal.sqlite3
VIRUSTOTAL_CACHE_TTL=86400

# Conservative default for public API quotas (roughly four requests/minute).
VIRUSTOTAL_MIN_INTERVAL=16
